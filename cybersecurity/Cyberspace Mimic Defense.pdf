            xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
            xmlns:stEvt="http://ns.adobe.com/xap/1.0/sType/ResourceEvent#">
         <xmpMM:DocumentID>uuid:4f441ce0-6f5e-48af-a731-36657b8a405e</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:8447e5c0-5d64-4b86-b3aa-250c07898cbb</xmpMM:InstanceID>
